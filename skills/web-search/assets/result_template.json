{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SearchResultList",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["title", "url", "snippet", "source"],
    "properties": {
      "title":   { "type": "string", "description": "Page title" },
      "url":     { "type": "string", "format": "uri" },
      "snippet": { "type": "string", "description": "Excerpt from the page" },
      "source":  { "type": "string", "description": "Domain of the result" }
    }
  }
}
